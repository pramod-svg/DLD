# Environment variables for DLD Voting Machine Simulator

# Port to run the server on (Render/Railway/Heroku sets this automatically)
PORT=5000

# MongoDB Connection String (e.g. from MongoDB Atlas)
# If omitted or unavailable, the application automatically falls back to in-memory mode seamlessly!
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dld_voting_machine?retryWrites=true&w=majority

# Node environment
NODE_ENV=production
